# Rust
/target

# Web
node_modules/
web/dist/

# Python (script nodes, corpus tooling — stage 4+)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Cicada runtime artifacts. The cache NEVER lives in the project folder by
# default (DECISIONS.md: project dirs are Dropbox-synced). `.cicada-cache/`
# is an opt-in override — ignored so an accidental opt-in never churns git.
# The lock file is last-solve state, local-only (DECISIONS.md .cic row).
.cicada-cache/
*.cic.lock

# Renders and large outputs
renders/
*.blend1

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Claude Code local settings (skills and shared settings ARE committed)
.claude/settings.local.json

# Debug exporter output (examples are re-runnable; artifacts stay local)
examples/*.obj
web/test-results/
web/playwright-report/

# Stage-6 corpus outputs (explicit exporter runs write here; production references live in corpus/golden/)
corpus/out/
examples/wall/out/
examples/*.csv
