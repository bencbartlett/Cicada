# cicada 1
# Mesh-tier solids: primitives, a Manifold carve, and the debug OBJ
# exporter.
# Solve only:        cargo run -p cicada-cli -- run examples/02-solids.cic
# Write the OBJ:     cargo run -p cicada-cli -- run examples/02-solids.cic --node dump
# (exporters are effectful: they NEVER run unless named with --node)

size = slider(value=2.0, min=0.5, max=5.0)
span = construct_domain(start=0.0, end=size)

# Spike solids are mesh-backed (Watertight<Mesh>) under their v0.1 names.
block = box(x=span, y=span, z=span)

# A ball poking through the block's top face...
top = construct_point(x=1.0, y=1.0, z=2.0)
top_frame = xy_plane(origin=top)
ball = sphere(plane=top_frame, radius=0.75, segments=24)

# Geometry lists come from nodes (list literals hold plain scalars);
# a count-1 linear_array is the idiomatic singleton.
still = unit_x(factor=0.0)
cutter_list = linear_array(geometry=ball, direction=still, count=1)

# The carve, via Manifold.
carved = mesh_difference(mesh=block, cutters=cutter_list)

# The debug window into headless geometry: any OBJ viewer opens this.
dump_list = linear_array(geometry=carved, direction=still, count=1)
dump = export_obj(meshes=dump_list, path="02-solids.obj")
