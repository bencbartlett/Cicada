# cicada 1
# a spike-subset pipeline in the worked-example's shape (docs/10)

amps = slider(value=12.0, min=0.0, max=30.0, step=0.5)
count = 40
show = toggle(value=True)
mode = choice(value="fast", options=["fast", "exact"])

seeds = scatter(region=board, count=1500, seed=7)
field = solve_field(coil=coil, samples=samples, current=amps)

frusta = frustum(profile=each(cells), direction=each(field.dirs), height=each(heights))
deep = smooth(mesh=each(each(contours)))

points, tangents, t = divide_curve(curve=rail, count=40)
h_total = base_h + cap_h * 0.5
z = x^2 + y**2

dxf = export_dxf(outline=board_outline, path="out/board.dxf")   # trailing note
